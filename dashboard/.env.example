# ═══════════════════════════════════════════════════════════════════════════
# PASSIO — Centre de pilotage : configuration
# Copier ce fichier en `.env` et renseigner les valeurs. NE JAMAIS committer `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=4610
# Environnement du DASHBOARD lui-même : development | test | staging | production.
# En production, les fonctions de modification de code / reset / simulation sont
# désactivées par défaut (voir DASH_ALLOW_MUTATIONS).
DASH_ENV=development

# ─── Authentification du tableau de bord ────────────────────────────────────
# Compte administrateur principal (rôle: admin).
DASH_ADMIN_USER=benjamin
DASH_ADMIN_PASSWORD=change-me-please
# Secret de signature des sessions (HMAC). Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DASH_SESSION_SECRET=remplace-par-une-chaine-aleatoire-longue
# Durée de validité d'une session, en heures.
DASH_SESSION_HOURS=12
# Utilisateurs supplémentaires, format  user:password:role  séparés par des virgules.
# Rôles possibles : admin | developer | tester | observer
# Ex : DASH_EXTRA_USERS=ami:motdepasse:tester,lea:secret:observer
DASH_EXTRA_USERS=

# ─── Supabase (backend Passio = magasin d'événements) ───────────────────────
# URL du projet Supabase de Passio.
SUPABASE_URL=https://njkiyoklssvefstljemx.supabase.co
# Clé service_role — LECTURE de la télémétrie (RLS bypassée). NE JAMAIS l'exposer
# côté navigateur : elle ne quitte jamais ce backend. Dashboard Supabase → Project
# Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Clé anon (facultative, informative).
SUPABASE_ANON_KEY=

# ─── Dépôt Git de Passio (module Modifications Git / Tests) ──────────────────
# Chemin ABSOLU vers le dépôt Passio. Par défaut, le parent de ce dossier.
PASSIO_REPO_PATH=..
# Autoriser les opérations qui MODIFIENT le dépôt (créer branche, appliquer patch).
# Toujours désactivé si DASH_ENV=production. Chaque action reste journalisée.
DASH_ALLOW_MUTATIONS=true

# ─── Intégration Claude Code / API Anthropic (facultatif) ───────────────────
# Si renseignée, l'assistant peut analyser un bug en direct. Sinon, le dashboard
# se contente de PRÉPARER le prompt (copier / envoyer à Claude Code manuellement).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Rétention / confidentialité ────────────────────────────────────────────
# Nombre d'événements gardés en mémoire vive pour le flux temps réel.
DASH_EVENT_BUFFER=5000
