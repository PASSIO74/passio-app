# ═══════════════════════════════════════════════════════════════════════════
# PASSIO — Centre de pilotage : configuration
# Copier ce fichier en `.env` et renseigner les valeurs. NE JAMAIS committer `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Serveur ────────────────────────────────────────────────────────────────
PORT=4610
# Environnement du DASHBOARD lui-même : development | test | staging | production.
# En production, les fonctions de modification de code / reset / simulation sont
# désactivées par défaut (voir DASH_ALLOW_MUTATIONS).
DASH_ENV=development

# ─── Authentification du tableau de bord ────────────────────────────────────
# Compte administrateur principal (rôle: admin).
DASH_ADMIN_USER=benjamin
DASH_ADMIN_PASSWORD=change-me-please
# Secret de signature des sessions (HMAC). Générer une valeur aléatoire longue :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DASH_SESSION_SECRET=remplace-par-une-chaine-aleatoire-longue
# Durée de validité d'une session, en heures.
DASH_SESSION_HOURS=12
# Utilisateurs supplémentaires, format  user:password:role  séparés par des virgules.
# Rôles possibles : admin | developer | tester | observer
# Ex : DASH_EXTRA_USERS=ami:motdepasse:tester,lea:secret:observer
DASH_EXTRA_USERS=

# ─── Supabase (backend Passio = magasin d'événements) ───────────────────────
# URL du projet Supabase de Passio.
SUPABASE_URL=https://njkiyoklssvefstljemx.supabase.co
# Clé service_role — LECTURE de la télémétrie (RLS bypassée). NE JAMAIS l'exposer
# côté navigateur : elle ne quitte jamais ce backend. Dashboard Supabase → Project
# Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Clé anon (facultative, informative).
SUPABASE_ANON_KEY=

# ─── Dépôt Git de Passio (module Modifications Git / Tests) ──────────────────
# Chemin ABSOLU vers le dépôt Passio. Par défaut, le parent de ce dossier.
PASSIO_REPO_PATH=..
# Autoriser les opérations qui MODIFIENT le dépôt (créer branche, appliquer patch).
# Toujours désactivé si DASH_ENV=production. Chaque action reste journalisée.
DASH_ALLOW_MUTATIONS=true

# ─── Intégration Claude Code / API Anthropic (facultatif) ───────────────────
# Si renseignée, l'assistant peut analyser un bug en direct. Sinon, le dashboard
# se contente de PRÉPARER le prompt (copier / envoyer à Claude Code manuellement).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── Autopilote de la sentinelle ────────────────────────────────────────────
# La chaîne complète : alerte → diagnostic → correctif écrit dans un worktree
# ISOLÉ → audits + tests → fusion dans la branche locale si tout est vert,
# `git reset --hard` au SHA d'avant sinon.
#
# Porte sans terminal : double-clic sur `Activer-Autopilote.cmd`
# (`/off` pour revenir au mode « propose seulement », `/etat` pour vérifier).
#
# ⚠️ IL NE DÉPLOIE JAMAIS EN PRODUCTION. `sentinel-autopilot.js` porte
# `productionDeploy: false` EN DUR, sans interrupteur, et l'exécuteur refuse
# toute promotion si DASH_ENV=production. Le `git push` reste un geste humain.
#
# ⚠️ La promotion fusionne dans la branche LOCALE cible et exige un arbre de
# travail PROPRE et la bonne branche courante — sinon elle s'abstient. Si tu
# codes en permanence sur `main`, vise une autre branche.
DASH_SENTINEL_AUTOPILOT=false
DASH_SENTINEL_LOCAL_GATE_V2=false
# Branche locale cible de la promotion (jamais poussée).
DASH_AUTOPILOT_TARGET_BRANCH=main
# Plafonds d'un correctif automatique : au-delà, ce n'est plus une réparation.
DASH_AUTOPILOT_MAX_LINES=60
DASH_AUTOPILOT_MAX_FILES=2
# Suites de vérification jouées AVANT de garder la fusion.
DASH_AUTOPILOT_VERIFY_SUITES=authz,globals,handlers,smoke
# Mise en quarantaine d'un motif après N réparations ratées (ou revenues).
DASH_SENTINEL_QUARANTINE_FAILS=2

# ─── Surveillance de la connexion Claude Code ───────────────────────────────
# La session OAuth du CLI expire toute seule ; sans re-détection, la sentinelle
# reste sourde jusqu'au prochain redémarrage et « aucun diagnostic » ressemble
# au calme. Cadence de la sonde `claude auth status`, en minutes (min. 1).
DASH_CLAUDE_CLI_WATCH_MIN=10

# ─── Rétention / confidentialité ────────────────────────────────────────────
# Nombre d'événements gardés en mémoire vive pour le flux temps réel.
DASH_EVENT_BUFFER=5000

# ─── Ne montrer que les VRAIS testeurs ──────────────────────────────────────
# N'ingérer/compter que les événements de PRODUCTION. Les runs e2e et le dev
# local émettent en env=development (des milliers de faux appareils jetables)
# et sont écartés d'office. Mettre à "false" pour tout revoir (debug).
DASH_ONLY_PROD_EVENTS=true
# Exclusion OPTIONNELLE de comptes des métriques testeurs (UID séparés par des
# virgules). Vide = tous les comptes réels comptent comme testeurs (les tiens
# inclus). Les comptes jetables @passio-e2e.test sont déjà exclus séparément.
DASH_INTERNAL_UIDS=
