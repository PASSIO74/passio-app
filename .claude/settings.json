{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"C:/Users/BENJAMIN/Desktop/PASSIO/.claude/scripts/garde-commandes.js\"",
            "timeout": 10,
            "statusMessage": "Contrôle des commandes destructives"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"C:/Users/BENJAMIN/Desktop/PASSIO/.claude/stage-edited-file.js\"",
            "statusMessage": "Indexation du fichier modifié"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"C:/Users/BENJAMIN/Desktop/PASSIO/.claude/scripts/compact-permissions.js\" --quiet",
            "timeout": 15,
            "async": true,
            "statusMessage": "Compactage des permissions"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Read(./.env)",
      "Read(./dashboard/.env)",
      "Read(./.claude/settings.local.json)"
    ]
  }
}
