{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-5",
  "availableModels": [
    "claude-opus-5"
  ],
  "teammateDefaultModel": "claude-opus-5",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \".claude/scripts/garde-commandes.js\"",
            "timeout": 10,
            "statusMessage": "Contrôle des commandes destructives"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \".claude/stage-edited-file.js\"",
            "statusMessage": "Indexation du fichier modifié"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \".claude/scripts/compact-permissions.js\" --quiet",
            "timeout": 15,
            "statusMessage": "Compactage des permissions"
          }
        ]
      }
    ]
  },
  "env": {
    "ENABLE_STOP_REVIEW": "0",
    "ANTHROPIC_MODEL": "claude-opus-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5"
  },
  "extraKnownMarketplaces": {
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      },
      "autoUpdate": true
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      },
      "autoUpdate": true
    },
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "netlify-skills@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "context7@context7-marketplace": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "supabase@supabase-agent-skills": true,
    "postgres-best-practices@supabase-agent-skills": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Skill",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "TodoWrite",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(diff *)",
      "Bash(which *)",
      "Bash(stat *)",
      "Bash(mkdir *)",
      "Bash(node scripts/audit-globals.js*)",
      "Bash(node scripts/audit-handlers.js*)",
      "Bash(node scripts/audit-echappement.js*)",
      "Bash(node scripts/audit-tests-creux.js*)",
      "Bash(npm run audit:handlers*)",
      "Bash(npm run audit:globals*)",
      "Bash(npm run audit:echappement*)",
      "Bash(npm run audit:tests*)",
      "Bash(npm test*)",
      "Bash(npx playwright test*)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git ls-tree *)",
      "Bash(git check-ignore *)",
      "Bash(git remote *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push --set-upstream origin claude/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push origin HEAD:claude/*)",
      "Bash(git push origin HEAD:refs/heads/claude/*)",
      "Bash(gh pr create *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr status *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./dashboard/.env)",
      "Read(./dashboard/.env.*)",
      "Edit(./dashboard/.env)",
      "Edit(./dashboard/.env.*)",
      "Write(./dashboard/.env)",
      "Write(./dashboard/.env.*)",
      "Read(./secrets/**)",
      "Edit(./secrets/**)",
      "Write(./secrets/**)",
      "Read(./.claude/settings.local.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)"
    ]
  }
}
